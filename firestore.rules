rules_version = '2';

// =============================================================================
// DO NOT publish this file by itself over the church app's rules.
//
// The live rules for project plainview-baptist-church-bfe21 are NOT in the
// public church website repo (plainviewbaptist/plainviewbaptist.github.io).
// They only exist in the Firebase console. Replacing them with this file
// would lock the church app out of its data.
//
// What Ronald should do is in the README: copy only the BEGIN/END block
// below into the existing Firestore rules, leave every church line in
// place, then click Publish.
//
// Church collections this must not disturb (seen in the church app):
// announcements, dailyPrayers, directory, displayFeeds, eventVideos, events,
// families, familyInvites, familyJoinRequests, familyLinkRequests, feedback,
// flyerSlides, live, memberApprovals, messages, notifications, photoDrops,
// prayerRequests, publicLive, sermons, settings, songRequests, users,
// videoCategories, welcomes.
//
// This app only adds printSuggestions and printProfiles.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Paste the church app's existing match blocks above this line
    // if you ever publish from this file. For the console, paste only
    // the block between the BEGIN and END lines into the rules that
    // are already there.

    // BEGIN PRINT QUEUE — copy from the next line through END PRINT QUEUE

    // Church admins and the church owner are already covered by pqIsChurchAdmin.
    // To also allow a specific email, replace `return false` with:
    //   return request.auth != null
    //     && request.auth.token.email != null
    //     && request.auth.token.email.lower() == "you@example.com";
    // Use the same email in firebase-config.js adminEmails, then publish again.
    function pqIsListedAdmin() {
      return false;
    }

    function pqIsChurchAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.owner == true
        );
    }

    function pqIsAdmin() {
      return pqIsListedAdmin() || pqIsChurchAdmin();
    }

    function pqValidStatus(status) {
      return status == "suggested"
        || status == "queued"
        || status == "printing"
        || status == "done";
    }

    function pqIsHttpUrl(url) {
      return url is string
        && url.size() >= 12
        && url.size() <= 2000
        && (url.matches("^https://.+") || url.matches("^http://.+"));
    }

    function pqValidNewSuggestion() {
      let data = request.resource.data;
      return data.keys().hasOnly(["profileId", "name", "title", "url", "notes", "status", "createdAt"])
        && data.profileId is string
        && data.profileId.size() >= 1
        && data.profileId.size() <= 40
        && data.profileId.matches("^[a-z0-9-]+$")
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 40
        && data.name.matches(".*\\S.*")
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 140
        && data.title.matches(".*\\S.*")
        && data.notes is string
        && data.notes.size() <= 1000
        && pqIsHttpUrl(data.url)
        && data.status == "suggested"
        && data.createdAt == request.time;
    }

    function pqValidProfilePhoto() {
      let data = request.resource.data;
      return data.keys().hasOnly(["photoUrl", "updatedAt"])
        && data.photoUrl is string
        && data.photoUrl.size() > 20
        && data.photoUrl.size() < 2000
        && data.photoUrl.matches("^https://firebasestorage\\.googleapis\\.com/.+")
        && data.updatedAt == request.time;
    }

    function pqValidPreviewUpdate() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys().hasOnly(["previewImageUrl", "previewTitle", "previewFetched"])
        && data.previewFetched == true
        && data.previewTitle is string
        && data.previewTitle.size() <= 180
        && data.previewImageUrl is string
        && data.previewImageUrl.size() <= 2000
        && (data.previewImageUrl == "" || data.previewImageUrl.matches("^https://.+"));
    }

    function pqValidRequestPhoto() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys().hasOnly(["photoUrl"])
        && data.photoUrl is string
        && data.photoUrl.size() < 2000
        && data.photoUrl.matches("^https://firebasestorage\\.googleapis\\.com/.+");
    }

    match /printSuggestions/{id} {
      allow read: if true;
      allow create: if pqValidNewSuggestion();
      allow update: if pqIsAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && pqValidStatus(request.resource.data.status);
      allow update: if pqValidPreviewUpdate();
      allow update: if pqValidRequestPhoto();
      allow delete: if pqIsAdmin();
    }

    match /printProfiles/{id} {
      allow read: if true;
      allow create, update: if pqValidProfilePhoto();
      // Removing a photo ("Use the emoji again") does not need an account.
      allow delete: if true;
    }

    // END PRINT QUEUE
  }
}
